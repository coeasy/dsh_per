{
  "name": "dsh-per",
  "version": "0.1.0",
  "description": "DSH multi-model orchestration plugin: plan / execute / review pipeline with auto fix-loop, budget and degradation",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": "./web/dist/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "web/dist/client.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-web.mjs",
    "pretest": "node scripts/build-web.mjs",
    "test": "vitest run",
    "version:check": "node scripts/check-version.mjs",
    "prepublishOnly": "pnpm run version:check && pnpm run build && pnpm run test && pnpm run ci:checks",
    "ci:checks": "node scripts/ci-checks.mjs"
  },
  "dependencies": {
    "zod": "^3.25.76",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coeasy/dsh_per.git"
  },
  "homepage": "https://github.com/coeasy/dsh_per#readme",
  "bugs": {
    "url": "https://github.com/coeasy/dsh_per/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "orchestrator",
    "multi-model",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT"
}
